---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { siteContact, socialLinks } from "../data/partners";

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);

const infoCards = [
  {
    icon: "✉️",
    title: t("contact.emailUs"),
    text: t("contact.emailUsText"),
    valueHref: `mailto:${siteContact.email}`,
    value: siteContact.email,
  },
  {
    icon: "📞",
    title: t("contact.callUs"),
    text: t("contact.callUsText"),
    valueHref: `tel:${siteContact.phone.replace(/\s+/g, "")}`,
    value: siteContact.phone,
  },
  {
    icon: "📍",
    title: t("contact.visitUs"),
    text: t("contact.visitUsText"),
    valueHref: null,
    value: siteContact.location[locale],
  },
];

const socialIcons: Record<string, string> = {
  Facebook: "M13 22v-8h2.6l.4-3H13V9.1c0-.9.2-1.6 1.6-1.6H16V4.9C15.6 4.9 14.5 4.8 13.3 4.8c-2.5 0-4.3 1.5-4.3 4.4V11H6.5v3H9v8h4z",
  Instagram:
    "M12 2c2.7 0 3.1 0 4.1.1 1.1 0 1.9.2 2.5.5.7.2 1.2.6 1.7 1.1.5.5.9 1 1.1 1.7.3.6.5 1.4.5 2.5.1 1 .1 1.4.1 4.1s0 3.1-.1 4.1c0 1.1-.2 1.9-.5 2.5-.2.7-.6 1.2-1.1 1.7-.5.5-1 .9-1.7 1.1-.6.3-1.4.5-2.5.5-1 .1-1.4.1-4.1.1s-3.1 0-4.1-.1c-1.1 0-1.9-.2-2.5-.5-.7-.2-1.2-.6-1.7-1.1-.5-.5-.9-1-1.1-1.7-.3-.6-.5-1.4-.5-2.5C2 15.1 2 14.7 2 12s0-3.1.1-4.1c0-1.1.2-1.9.5-2.5.2-.7.6-1.2 1.1-1.7.5-.5 1-.9 1.7-1.1.6-.3 1.4-.5 2.5-.5C8.9 2 9.3 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm5.2-3.4a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z",
  YouTube:
    "M21.6 7.2s-.2-1.5-.9-2.2c-.8-.9-1.7-.9-2.1-1C15.7 3.8 12 3.8 12 3.8h0s-3.7 0-6.6.2c-.4 0-1.3.1-2.1 1-.7.7-.9 2.2-.9 2.2S2.2 9 2.2 10.7v1.5c0 1.8.2 3.5.2 3.5s.2 1.5.9 2.2c.8.9 1.9.9 2.4 1 1.7.2 7.3.2 7.3.2s3.7 0 6.6-.2c.4 0 1.3-.1 2.1-1 .7-.7.9-2.2.9-2.2s.2-1.8.2-3.5v-1.5c0-1.8-.2-3.5-.2-3.5ZM9.9 14.6V8.9l5.5 2.9-5.5 2.8Z",
  LinkedIn:
    "M4.98 3.5C4.98 4.9 3.9 6 2.5 6S0 4.9 0 3.5C0 2.1 1.1 1 2.5 1s2.48 1.1 2.48 2.5ZM.2 8.3H4.8V23H.2V8.3ZM8.3 8.3h4.4v2h.06c.6-1.1 2.1-2.3 4.3-2.3 4.6 0 5.5 3 5.5 6.9V23h-4.6v-6.7c0-1.6 0-3.7-2.2-3.7-2.3 0-2.6 1.8-2.6 3.6V23H8.3V8.3Z",
};
---

<Layout title={t("contact.heroTitle")} description={t("contact.heroSubtitle")}>
  <Hero title={t("contact.heroTitle")} subtitle={t("contact.heroSubtitle")} compact />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        infoCards.map((card) => (
          <div class="rounded-2xl border border-slate-100 bg-white p-6 text-center shadow-sm">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-coral/10 text-2xl mx-auto" aria-hidden="true">
              {card.icon}
            </span>
            <h2 class="mt-3 font-display text-base font-bold text-charcoal">{card.title}</h2>
            <p class="mt-1 text-sm text-slate-muted">{card.text}</p>
            {card.valueHref ? (
              <a href={card.valueHref} class="mt-2 inline-block font-medium text-coral hover:underline">
                {card.value}
              </a>
            ) : (
              <p class="mt-2 font-medium text-coral">{card.value}</p>
            )}
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-14 max-w-2xl">
      <h2 class="font-display text-xl font-bold text-charcoal">{t("contact.formHeading")}</h2>
      <p class="mt-2 text-slate-muted">{t("contact.formText")}</p>

      <!--
        No backend is wired up yet — this is a static site. Before launch,
        point the form at a static-friendly submission handler (e.g.
        Formspree, Netlify Forms, or a small serverless function) and remove
        the client-side placeholder handler in contactForm.client.ts.
      -->
      <form class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2" data-contact-form>
        <div class="sm:col-span-1">
          <label for="name" class="mb-1 block text-sm font-medium text-charcoal">{t("contact.name")}</label>
          <input id="name" name="name" type="text" required class="w-full rounded-lg border border-slate-200 px-3 py-2 focus:border-coral focus:outline-none" />
        </div>
        <div class="sm:col-span-1">
          <label for="email" class="mb-1 block text-sm font-medium text-charcoal">{t("contact.email")}</label>
          <input id="email" name="email" type="email" required class="w-full rounded-lg border border-slate-200 px-3 py-2 focus:border-coral focus:outline-none" />
        </div>
        <div class="sm:col-span-1">
          <label for="phone" class="mb-1 block text-sm font-medium text-charcoal">{t("contact.phone")}</label>
          <input id="phone" name="phone" type="tel" class="w-full rounded-lg border border-slate-200 px-3 py-2 focus:border-coral focus:outline-none" />
        </div>
        <div class="sm:col-span-1">
          <label for="subject" class="mb-1 block text-sm font-medium text-charcoal">{t("contact.subject")}</label>
          <input id="subject" name="subject" type="text" class="w-full rounded-lg border border-slate-200 px-3 py-2 focus:border-coral focus:outline-none" />
        </div>
        <div class="sm:col-span-2">
          <label for="message" class="mb-1 block text-sm font-medium text-charcoal">{t("contact.message")}</label>
          <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-slate-200 px-3 py-2 focus:border-coral focus:outline-none"></textarea>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="w-full rounded-full bg-coral px-6 py-3 text-sm font-semibold text-white hover:bg-coral-dark sm:w-auto">
            {t("contact.send")}
          </button>
          <p class="mt-3 hidden text-sm text-emerald-700" data-form-success>{t("contact.formSuccess")}</p>
        </div>
      </form>
    </div>

    <div class="mx-auto mt-14 max-w-2xl text-center">
      <h2 class="font-display text-lg font-bold text-charcoal">{t("contact.followUs")}</h2>
      <p class="mt-1 text-sm text-slate-muted">{t("contact.followUsText")}</p>
      <div class="mt-4 flex justify-center gap-3">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              aria-label={link.label}
              class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-50 text-brand-blue ring-1 ring-slate-200 hover:text-coral"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d={socialIcons[link.label]} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script src="../scripts/contactForm.client.ts"></script>
</Layout>

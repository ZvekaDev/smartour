---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getLangFromUrl, useTranslations, localizePath } from "../i18n/utils";
import { aboutUs } from "../data/aboutUs";
import { urlForImage } from "../lib/sanity";

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const heroImageUrl = aboutUs.heroImage ? urlForImage(aboutUs.heroImage).width(1920).height(700).fit("crop").url() : null;
---

<Layout title={aboutUs.heroTitle[locale]} description={aboutUs.heroSubtitle[locale]}>
  <Hero title={aboutUs.heroTitle[locale]} subtitle={aboutUs.heroSubtitle[locale]} imageUrl={heroImageUrl} />

  <!-- Who We Are -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wide text-coral">{aboutUs.whoWeAreTagline[locale]}</span>
        <h2 class="mt-2 font-display text-2xl font-bold text-charcoal sm:text-3xl">{aboutUs.whoWeAreHeading[locale]}</h2>
        {aboutUs.whoWeAreParagraphs[locale].map((p) => <p class="mt-4 text-slate-muted">{p}</p>)}
        <div class="mt-8 flex gap-8">
          {
            aboutUs.stats.map((stat) => (
              <div>
                <div class="font-display text-3xl font-bold text-coral">{stat.number}</div>
                <div class="text-sm text-slate-muted">{stat.label[locale]}</div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="flex aspect-square items-center justify-center overflow-hidden rounded-3xl bg-gradient-to-br from-coral/15 via-brand-blue/10 to-slate-100 text-8xl">
        {
          aboutUs.heroImage ? (
            <img
              src={urlForImage(aboutUs.heroImage).width(900).height(900).fit("crop").url()}
              alt={aboutUs.heroTitle[locale]}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          ) : (
            "🤝"
          )
        }
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="bg-slate-50 py-16">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm">
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-coral/10 text-2xl" aria-hidden="true">🎯</span>
        <h2 class="mt-4 font-display text-xl font-bold text-charcoal">{aboutUs.missionTagline[locale]}</h2>
        <p class="mt-3 text-slate-muted">{aboutUs.missionParagraph[locale]}</p>
      </div>
      <div class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm">
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-blue/10 text-2xl" aria-hidden="true">🔭</span>
        <h2 class="mt-4 font-display text-xl font-bold text-charcoal">{aboutUs.visionTagline[locale]}</h2>
        <p class="mt-3 text-slate-muted">{aboutUs.visionParagraph[locale]}</p>
      </div>
    </div>
  </section>

  <!-- What We Offer -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="font-display text-2xl font-bold text-charcoal sm:text-3xl">{aboutUs.offerHeading[locale]}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-muted">{aboutUs.offerSubheading[locale]}</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        aboutUs.offerCards.map((card) => (
          <div class="rounded-2xl border border-slate-100 bg-white p-6 text-center shadow-sm">
            <span class="text-3xl" aria-hidden="true">
              {card.icon}
            </span>
            <h3 class="mt-3 font-display text-base font-semibold text-charcoal">{card.title[locale]}</h3>
            <p class="mt-2 text-sm text-slate-muted">{card.text[locale]}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Our Story -->
  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <span class="text-xs font-semibold uppercase tracking-wide text-coral">{aboutUs.storyTagline[locale]}</span>
      <h2 class="mt-2 font-display text-2xl font-bold text-charcoal sm:text-3xl">{aboutUs.storyHeading[locale]}</h2>
      <p class="mt-4 text-slate-muted">{aboutUs.storyParagraph[locale]}</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-gradient-to-br from-charcoal via-slate-800 to-coral-dark py-20 text-center text-white">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl font-bold">{aboutUs.ctaHeading[locale]}</h2>
      <p class="mt-4 text-white/85">{aboutUs.ctaText[locale]}</p>
      <a
        href={localizePath("/contact", locale)}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-charcoal shadow-sm hover:bg-slate-100"
      >
        {t("nav.contact")} →
      </a>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, localizePath } from "../i18n/utils";
import transportData, { transportHeroImage } from "../lib/transport";
import { urlForImage } from "../lib/sanity";

const locale = getLangFromUrl(Astro.url);
const data = transportData[locale];
const heroImageUrl = transportHeroImage
  ? urlForImage(transportHeroImage).width(1920).height(700).fit("crop").url()
  : null;

// Bootstrap Icons (used by the source content) -> emoji, since the site
// doesn't otherwise depend on an icon font.
const iconMap: Record<string, string> = {
  "bi bi-train-front": "🚆",
  "bi bi-bus-front": "🚌",
  "bi bi-sign-turn-right": "🛣️",
  "bi bi-map": "🗺️",
  "bi bi-globe2": "🌐",
  "bi bi-camera-video": "📹",
  "bi bi-clock-history": "🕐",
  "bi bi-shield-check": "🛡️",
  "bi bi-compass": "🧭",
  "bi bi-geo-alt": "📍",
};
const icon = (key: string) => iconMap[key] ?? "•";
---

<Layout title={data.hero.title} description={data.hero.subtitle}>
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-800 to-brand-blue py-20 text-white">
    {heroImageUrl && <img src={heroImageUrl} alt="" class="absolute inset-0 h-full w-full object-cover" />}
    {
      heroImageUrl ? (
        <div class="absolute inset-0 bg-black/55" />
      ) : (
        <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-10" aria-hidden="true">
          <defs>
            <pattern id="transport-dots" width="28" height="28" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="1.4" fill="white" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#transport-dots)" />
        </svg>
      )
    }
    <div class="relative mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="font-heading text-4xl font-bold sm:text-5xl">{data.hero.title}</h1>
      <p class="mt-4 text-lg text-white/85">{data.hero.subtitle}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <!-- Quick jump cards -->
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        data.quickCards.map((card) => (
          <a
            href={card.anchor}
            class="rounded-2xl border border-slate-100 bg-white p-6 text-center shadow-sm transition-shadow hover:shadow-md"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-blue/10 text-2xl mx-auto" aria-hidden="true">
              {icon(card.icon)}
            </span>
            <h2 class="mt-3 font-display text-sm font-bold text-charcoal">{card.title}</h2>
            <p class="mt-1 text-xs text-slate-muted">{card.text}</p>
          </a>
        ))
      }
    </div>

    <!-- Sections -->
    {
      data.blocks.map((block) => (
        <div id={block.id} class="mt-16 scroll-mt-24">
          <div class="flex items-start gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-coral/10 text-2xl" aria-hidden="true">
              {icon(block.icon)}
            </span>
            <div>
              <h3 class="font-display text-xl font-bold text-charcoal">{block.title}</h3>
              <p class="mt-1 text-slate-muted">{block.subtitle}</p>
            </div>
          </div>
          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {block.links.map((link) => (
              <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <div class="flex items-center gap-2">
                  <span aria-hidden="true">{icon(link.icon)}</span>
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="font-semibold text-coral hover:underline">
                    {link.text}
                  </a>
                </div>
                <p class="mt-2 text-sm text-slate-muted">{link.description}</p>
              </div>
            ))}
          </div>
        </div>
      ))
    }

    <!-- CTA -->
    <div class="mt-16 rounded-3xl bg-gradient-to-br from-charcoal via-slate-800 to-coral-dark p-10 text-center text-white">
      <h3 class="font-heading text-2xl font-bold">{data.cta.title}</h3>
      <p class="mx-auto mt-3 max-w-xl text-white/85">{data.cta.text}</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href={localizePath("/offers", locale)} class="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-charcoal hover:bg-slate-100">
          {data.cta.primaryText} →
        </a>
        <a href={localizePath("/contact", locale)} class="rounded-full border border-white/30 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10">
          {data.cta.secondaryText}
        </a>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import OfferCard from "../components/OfferCard.astro";
import OfferMap from "../components/OfferMap.astro";
import { getLangFromUrl, useTranslations, localizePath } from "../i18n/utils";
import {
  offers,
  offerHref,
  categoryIcon,
  categoryName,
  countyName,
  townName,
  urlForImage,
  type Offer,
} from "../lib/offers";

interface Props {
  offer: Offer;
}

const { offer } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);

const icon = categoryIcon[offer.category] ?? "📍";
const location = [townName(offer.townSlug, locale), countyName(offer.countySlug, locale)].filter(Boolean).join(", ");

const photos = offer.photos.map((photo) => ({
  thumb: urlForImage(photo).width(480).height(360).fit("crop").url(),
  full: urlForImage(photo).width(1600).url(),
  alt: photo.alt || offer.title[locale],
}));

/** Turns a YouTube/Vimeo watch link into its embeddable form; returns null for anything else. */
function toEmbedUrl(url: string): string | null {
  try {
    const u = new URL(url);
    if (u.hostname.includes("youtube.com")) {
      const id = u.searchParams.get("v");
      return id ? `https://www.youtube.com/embed/${id}` : null;
    }
    if (u.hostname === "youtu.be") {
      const id = u.pathname.slice(1);
      return id ? `https://www.youtube.com/embed/${id}` : null;
    }
    if (u.hostname.includes("vimeo.com")) {
      const id = u.pathname.split("/").filter(Boolean)[0];
      return id ? `https://player.vimeo.com/video/${id}` : null;
    }
  } catch {
    // not a valid URL — fall through
  }
  return null;
}

const relatedOffers = offers
  .filter((o) => o.id !== offer.id && o.category === offer.category)
  .slice(0, 3);

const googleMapsUrl =
  offer.lat && offer.lng ? `https://www.google.com/maps/search/?api=1&query=${offer.lat},${offer.lng}` : null;
---

<Layout title={offer.title[locale]} description={offer.description[locale].slice(0, 160)}>
  <!-- Header: gradient placeholder (no third-party imagery) + breadcrumb + title -->
  <section class="relative overflow-hidden bg-gradient-to-br from-charcoal via-slate-800 to-coral-dark py-16 text-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav aria-label={t("a11y.breadcrumb")} class="mb-4 flex items-center gap-2 text-sm text-white/70">
        <a href={localizePath("/", locale)} class="hover:text-white">{t("nav.home")}</a>
        <span>/</span>
        <a href={localizePath("/offers", locale)} class="hover:text-white">{t("nav.offers")}</a>
        <span>/</span>
        <span class="text-white">{offer.title[locale]}</span>
      </nav>
      <div class="flex items-center gap-4">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-3xl" aria-hidden="true">
          {icon}
        </span>
        <div>
          <h1 class="font-heading text-3xl font-bold sm:text-4xl">{offer.title[locale]}</h1>
          {
            location && (
              <p class="mt-1 flex items-center gap-1 text-white/80">
                <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21Z" stroke="currentColor" stroke-width="1.5" />
                  <circle cx="12" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.5" />
                </svg>
                {location}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    (photos.length > 0 || offer.videos.length > 0) && (
      <section class="mx-auto max-w-5xl px-4 pt-10 sm:px-6 lg:px-8">
        {photos.length > 0 && (
          <div class="mb-10">
            <h2 class="mb-4 font-display text-xl font-bold text-charcoal">{t("offers.photos")}</h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {photos.map((photo) => (
                <a
                  href={photo.full}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block aspect-[4/3] overflow-hidden rounded-xl border border-slate-100 bg-slate-100"
                >
                  <img
                    src={photo.thumb}
                    alt={photo.alt}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform hover:scale-105"
                  />
                </a>
              ))}
            </div>
          </div>
        )}

        {offer.videos.length > 0 && (
          <div class="mb-10">
            <h2 class="mb-4 font-display text-xl font-bold text-charcoal">{t("offers.videos")}</h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              {offer.videos.map((video) => {
                const embedUrl = video.type === "embed" ? toEmbedUrl(video.url) : null;
                return (
                  <div>
                    <div class="aspect-video overflow-hidden rounded-xl border border-slate-100 bg-slate-950">
                      {video.type === "file" ? (
                        <video controls class="h-full w-full" src={video.url} />
                      ) : embedUrl ? (
                        <iframe
                          class="h-full w-full"
                          src={embedUrl}
                          title={video.caption ?? offer.title[locale]}
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                        />
                      ) : (
                        <a
                          href={video.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex h-full w-full items-center justify-center text-sm font-medium text-white/80 hover:text-white"
                        >
                          {t("offers.watchVideo")} ↗
                        </a>
                      )}
                    </div>
                    {video.caption && <p class="mt-2 text-sm text-slate-muted">{video.caption}</p>}
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </section>
    )
  }

  <section class:list={["mx-auto max-w-5xl px-4 pb-12 sm:px-6 lg:px-8", (photos.length > 0 || offer.videos.length > 0) ? "pt-0" : "pt-12"]}>
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="font-display text-xl font-bold text-charcoal">{t("offers.aboutOffer")}</h2>
        <p class="mt-4 whitespace-pre-line text-slate-muted">{offer.description[locale]}</p>

        {
          offer.lat && offer.lng && (
            <div class="mt-10">
              <h2 class="mb-4 font-display text-xl font-bold text-charcoal">{t("offers.location")}</h2>
              <OfferMap lat={offer.lat} lng={offer.lng} title={offer.title[locale]} />
              {googleMapsUrl && (
                <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-coral hover:underline">
                  {t("offers.openInGoogleMaps")} ↗
                </a>
              )}
            </div>
          )
        }
      </div>

      <!-- Offer Details panel -->
      <aside>
        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
          <h2 class="font-display text-base font-bold text-charcoal">{t("offers.offerDetails")}</h2>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">{t("offers.category")}</dt>
              <dd class="mt-1 text-charcoal">{categoryName(offer.category, locale)}</dd>
            </div>
            {
              location && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">{t("offers.location")}</dt>
                  <dd class="mt-1 text-charcoal">{location}</dd>
                </div>
              )
            }
            {
              offer.address && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">{t("offers.address")}</dt>
                  <dd class="mt-1 text-charcoal">
                    {offer.address}
                    {offer.zip ? `, ${offer.zip}` : ""}
                  </dd>
                </div>
              )
            }
            {
              offer.email && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">{t("offers.email")}</dt>
                  <dd class="mt-1">
                    <a href={`mailto:${offer.email}`} class="text-coral hover:underline">
                      {offer.email}
                    </a>
                  </dd>
                </div>
              )
            }
            {
              offer.phone && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">{t("offers.phone")}</dt>
                  <dd class="mt-1">
                    <a href={`tel:${offer.phone.replace(/\s+/g, "")}`} class="text-coral hover:underline">
                      {offer.phone}
                    </a>
                  </dd>
                </div>
              )
            }
            {
              offer.website && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">{t("offers.website")}</dt>
                  <dd class="mt-1 truncate">
                    <a href={offer.website} target="_blank" rel="noopener noreferrer" class="text-coral hover:underline">
                      {offer.website.replace(/^https?:\/\//, "")}
                    </a>
                  </dd>
                </div>
              )
            }
          </dl>

          {
            (offer.facebook || offer.instagram || offer.tiktok) && (
              <div class="mt-5 flex gap-2 border-t border-slate-100 pt-5">
                {offer.facebook && (
                  <a href={offer.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-50 text-brand-blue hover:bg-slate-100">
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M13 22v-8h2.6l.4-3H13V9.1c0-.9.2-1.6 1.6-1.6H16V4.9C15.6 4.9 14.5 4.8 13.3 4.8c-2.5 0-4.3 1.5-4.3 4.4V11H6.5v3H9v8h4z" /></svg>
                  </a>
                )}
                {offer.instagram && (
                  <a href={offer.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-50 text-brand-blue hover:bg-slate-100">
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M12 2c2.7 0 3.1 0 4.1.1 1.1 0 1.9.2 2.5.5.7.2 1.2.6 1.7 1.1.5.5.9 1 1.1 1.7.3.6.5 1.4.5 2.5.1 1 .1 1.4.1 4.1s0 3.1-.1 4.1c0 1.1-.2 1.9-.5 2.5-.2.7-.6 1.2-1.1 1.7-.5.5-1 .9-1.7 1.1-.6.3-1.4.5-2.5.5-1 .1-1.4.1-4.1.1s-3.1 0-4.1-.1c-1.1 0-1.9-.2-2.5-.5-.7-.2-1.2-.6-1.7-1.1-.5-.5-.9-1-1.1-1.7-.3-.6-.5-1.4-.5-2.5C2 15.1 2 14.7 2 12s0-3.1.1-4.1c0-1.1.2-1.9.5-2.5.2-.7.6-1.2 1.1-1.7.5-.5 1-.9 1.7-1.1.6-.3 1.4-.5 2.5-.5C8.9 2 9.3 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm5.2-3.4a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z" /></svg>
                  </a>
                )}
                {offer.tiktok && (
                  <a href={offer.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-50 text-brand-blue hover:bg-slate-100">
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M16.5 2h-3.2v13.8a2.9 2.9 0 1 1-2.4-2.9v-3.3a6.2 6.2 0 1 0 5.6 6.2V8.4a7.6 7.6 0 0 0 4.5 1.5V6.7a4.3 4.3 0 0 1-4.5-4.2Z" /></svg>
                  </a>
                )}
              </div>
            )
          }
        </div>
      </aside>
    </div>

    {
      relatedOffers.length > 0 && (
        <div class="mt-16">
          <h2 class="mb-6 font-display text-xl font-bold text-charcoal">{t("offers.relatedOffers")}</h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
            {relatedOffers.map((related) => <OfferCard offer={related} />)}
          </div>
        </div>
      )
    }

    <div class="mt-12">
      <a href={localizePath("/offers", locale)} class="text-sm font-medium text-coral hover:underline">
        ← {t("offers.backToOffers")}
      </a>
    </div>
  </section>
</Layout>

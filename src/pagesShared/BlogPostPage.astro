---
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";
import { getLangFromUrl, useTranslations, localizePath, formatDate } from "../i18n/utils";
import { blogPosts, type BlogPost } from "../data/blog/posts";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);

const morePosts = blogPosts.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<Layout title={post.title[locale]} description={post.excerpt[locale]}>
  <section class:list={["bg-gradient-to-br py-20 text-white", post.coverGradient]}>
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <nav aria-label={t("a11y.breadcrumb")} class="mb-4 flex items-center gap-2 text-sm text-white/70">
        <a href={localizePath("/", locale)} class="hover:text-white">{t("nav.home")}</a>
        <span>/</span>
        <a href={localizePath("/blogs", locale)} class="hover:text-white">{t("nav.blogs")}</a>
      </nav>
      <h1 class="font-heading text-3xl font-bold sm:text-4xl">{post.title[locale]}</h1>
      <div class="mt-4 flex items-center gap-4 text-sm text-white/80">
        <span>{post.author}</span>
        <span>{formatDate(post.date, locale)}</span>
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <p class="text-lg font-medium text-slate-muted">{post.excerpt[locale]}</p>
    <div class="prose-content mt-6 space-y-5 text-charcoal">
      {post.body[locale].map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="mt-12">
      <a href={localizePath("/blogs", locale)} class="text-sm font-medium text-coral hover:underline">
        ← {t("blog.backToBlogs")}
      </a>
    </div>
  </article>

  {
    morePosts.length > 0 && (
      <section class="bg-slate-50 py-14">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2 class="mb-6 font-display text-xl font-bold text-charcoal">{t("blog.morePosts")}</h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
            {morePosts.map((p) => <BlogCard post={p} />)}
          </div>
        </div>
      </section>
    )
  }
</Layout>

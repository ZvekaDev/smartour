---
import { locales, localeNames, localeFlags } from "../i18n/ui";
import { getLangFromUrl, getLocalizedAlternate } from "../i18n/utils";

const currentLocale = getLangFromUrl(Astro.url);
---

<div class="relative" data-lang-switcher>
  <button
    type="button"
    class="flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-sm text-charcoal hover:border-coral"
    aria-haspopup="listbox"
    aria-expanded="false"
    data-lang-toggle
  >
    <span aria-hidden="true" class="text-base leading-none">{localeFlags[currentLocale]}</span>
    <span class="sr-only">Selected language: {localeNames[currentLocale]}</span>
    <svg class="h-3 w-3" viewBox="0 0 12 8" fill="none" aria-hidden="true">
      <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>

  <ul
    class="absolute right-0 z-20 mt-2 hidden w-40 overflow-hidden rounded-lg border border-slate-200 bg-white py-1 shadow-lg"
    role="listbox"
    data-lang-menu
  >
    {
      locales.map((locale) => (
        <li>
          <a
            href={getLocalizedAlternate(Astro.url, locale)}
            class:list={[
              "flex items-center gap-2 px-3 py-2 text-sm hover:bg-slate-50",
              locale === currentLocale ? "font-semibold text-coral-dark" : "text-charcoal",
            ]}
            aria-current={locale === currentLocale ? "true" : undefined}
          >
            <span aria-hidden="true">{localeFlags[locale]}</span>
            {localeNames[locale]}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  // Toggle the language dropdown; scoped so multiple switchers (desktop/mobile) work independently.
  document.querySelectorAll("[data-lang-switcher]").forEach((root) => {
    const toggle = root.querySelector("[data-lang-toggle]");
    const menu = root.querySelector("[data-lang-menu]");
    if (!toggle || !menu) return;

    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = !menu.classList.contains("hidden");
      menu.classList.toggle("hidden", isOpen);
      toggle.setAttribute("aria-expanded", String(!isOpen));
    });

    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>

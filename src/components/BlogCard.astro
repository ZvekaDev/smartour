---
import { getLangFromUrl, localizePath, formatDate } from "../i18n/utils";
import { urlForImage } from "../lib/sanity";
import type { BlogPost } from "../data/blog/posts";

interface Props {
  post: BlogPost;
  size?: "sm" | "lg";
}

const { post, size = "sm" } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const href = `${localizePath("/blogs", locale)}/${post.slug}`;
const formattedDate = formatDate(post.date, locale);
const coverUrl = post.coverImage
  ? urlForImage(post.coverImage).width(size === "lg" ? 900 : 480).height(size === "lg" ? 500 : 240).fit("crop").url()
  : null;
---

<a href={href} class="group block h-full overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition-shadow hover:shadow-md">
  {
    size === "lg" ? (
      <div class:list={["relative flex h-64 flex-col justify-end overflow-hidden bg-gradient-to-br p-5 text-white", post.coverGradient]}>
        {coverUrl && <img src={coverUrl} alt={post.title[locale]} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />}
        <div class:list={["relative", coverUrl && "bg-gradient-to-t from-black/70 via-black/10 to-transparent -m-5 p-5 pt-16"]}>
          <h3 class="font-display text-xl font-bold">{post.title[locale]}</h3>
          <div class="mt-2 flex items-center justify-between text-xs text-white/80">
            <span>{post.author}</span>
            <span>{formattedDate}</span>
          </div>
        </div>
      </div>
    ) : (
      <div>
        <div class:list={["flex h-32 items-center overflow-hidden bg-gradient-to-br", post.coverGradient]}>
          {coverUrl && <img src={coverUrl} alt={post.title[locale]} loading="lazy" class="h-full w-full object-cover" />}
        </div>
        <div class="p-4">
          <h3 class="line-clamp-2 font-display text-sm font-semibold text-charcoal">{post.title[locale]}</h3>
          <div class="mt-3 flex items-center justify-between text-xs text-slate-muted">
            <span>{post.author}</span>
            <span>{formattedDate}</span>
          </div>
        </div>
      </div>
    )
  }
</a>

---
import EuInterregLogo from "./EuInterregLogo.astro";
import { getLangFromUrl, useTranslations, localizePath } from "../i18n/utils";
import { partners, siteContact, socialLinks } from "../data/partners";

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const year = new Date().getFullYear();

const quickLinks = [
  { path: "/", key: "nav.home" as const },
  { path: "/offers", key: "nav.offers" as const },
  { path: "/blogs", key: "nav.blogs" as const },
  { path: "/about-us", key: "nav.about" as const },
];
const exploreLinks = [
  { path: "/transport", key: "nav.transport" as const },
  { path: "/contact", key: "nav.contact" as const },
];

const socialIcons: Record<string, string> = {
  Facebook: "M13 22v-8h2.6l.4-3H13V9.1c0-.9.2-1.6 1.6-1.6H16V4.9C15.6 4.9 14.5 4.8 13.3 4.8c-2.5 0-4.3 1.5-4.3 4.4V11H6.5v3H9v8h4z",
  Instagram:
    "M12 2c2.7 0 3.1 0 4.1.1 1.1 0 1.9.2 2.5.5.7.2 1.2.6 1.7 1.1.5.5.9 1 1.1 1.7.3.6.5 1.4.5 2.5.1 1 .1 1.4.1 4.1s0 3.1-.1 4.1c0 1.1-.2 1.9-.5 2.5-.2.7-.6 1.2-1.1 1.7-.5.5-1 .9-1.7 1.1-.6.3-1.4.5-2.5.5-1 .1-1.4.1-4.1.1s-3.1 0-4.1-.1c-1.1 0-1.9-.2-2.5-.5-.7-.2-1.2-.6-1.7-1.1-.5-.5-.9-1-1.1-1.7-.3-.6-.5-1.4-.5-2.5C2 15.1 2 14.7 2 12s0-3.1.1-4.1c0-1.1.2-1.9.5-2.5.2-.7.6-1.2 1.1-1.7.5-.5 1-.9 1.7-1.1.6-.3 1.4-.5 2.5-.5C8.9 2 9.3 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm5.2-3.4a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z",
  YouTube:
    "M21.6 7.2s-.2-1.5-.9-2.2c-.8-.9-1.7-.9-2.1-1C15.7 3.8 12 3.8 12 3.8h0s-3.7 0-6.6.2c-.4 0-1.3.1-2.1 1-.7.7-.9 2.2-.9 2.2S2.2 9 2.2 10.7v1.5c0 1.8.2 3.5.2 3.5s.2 1.5.9 2.2c.8.9 1.9.9 2.4 1 1.7.2 7.3.2 7.3.2s3.7 0 6.6-.2c.4 0 1.3-.1 2.1-1 .7-.7.9-2.2.9-2.2s.2-1.8.2-3.5v-1.5c0-1.8-.2-3.5-.2-3.5ZM9.9 14.6V8.9l5.5 2.9-5.5 2.8Z",
  LinkedIn:
    "M4.98 3.5C4.98 4.9 3.9 6 2.5 6S0 4.9 0 3.5C0 2.1 1.1 1 2.5 1s2.48 1.1 2.48 2.5ZM.2 8.3H4.8V23H.2V8.3ZM8.3 8.3h4.4v2h.06c.6-1.1 2.1-2.3 4.3-2.3 4.6 0 5.5 3 5.5 6.9V23h-4.6v-6.7c0-1.6 0-3.7-2.2-3.7-2.3 0-2.6 1.8-2.6 3.6V23H8.3V8.3Z",
};
---

<footer class="border-t border-slate-100 bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4">
      <!-- Brand + tagline + social -->
      <div>
        <a href={localizePath("/", locale)} class="font-display text-2xl font-bold">
          <span class="text-charcoal">SMART</span><span class="text-brand-blue">our</span>
        </a>
        <p class="mt-3 max-w-xs text-sm text-slate-muted">{t("footer.tagline")}</p>
        <div class="mt-4 flex gap-3">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                aria-label={link.label}
                class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-brand-blue shadow-sm ring-1 ring-slate-200 hover:text-coral-dark"
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                  <path d={socialIcons[link.label]} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Quick links -->
      <nav aria-label={t("footer.quickLinks")}>
        <h3 class="font-display text-sm font-bold uppercase tracking-wide text-charcoal">
          {t("footer.quickLinks")}
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-slate-muted">
          {
            quickLinks.map((item) => (
              <li>
                <a href={localizePath(item.path, locale)} class="hover:text-coral-dark">
                  {t(item.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Explore -->
      <nav aria-label={t("footer.explore")}>
        <h3 class="font-display text-sm font-bold uppercase tracking-wide text-charcoal">
          {t("footer.explore")}
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-slate-muted">
          {
            exploreLinks.map((item) => (
              <li>
                <a href={localizePath(item.path, locale)} class="hover:text-coral-dark">
                  {t(item.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h3 class="font-display text-sm font-bold uppercase tracking-wide text-charcoal">
          {t("footer.contactUs")}
        </h3>
        <ul class="mt-4 space-y-3 text-sm text-slate-muted">
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-blue" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 6h18v12H3z" stroke="currentColor" stroke-width="1.5" />
              <path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <a href={`mailto:${siteContact.email}`} class="hover:text-coral-dark">{siteContact.email}</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-blue" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M4 5c0 8.3 6.7 15 15 15l2-3-5-3-1.5 2A11 11 0 0 1 7.5 9.5L9.5 8l-3-5-3 2Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
            </svg>
            <a href={`tel:${siteContact.phone}`} class="hover:text-coral-dark">{siteContact.phone}</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-blue" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21Z"
                stroke="currentColor"
                stroke-width="1.5"
              />
              <circle cx="12" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span>{siteContact.location[locale]}</span>
          </li>
        </ul>

        <ul class="mt-5 space-y-3 border-t border-slate-200 pt-4 text-sm text-slate-muted">
          {
            partners.map((partner) => (
              <li class="flex items-start gap-2">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-blue" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M4 21V5l8-2 8 2v16M9 21v-5h6v5M4 21h16"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>
                  {partner.name[locale]} –{" "}
                  <a href={`mailto:${partner.email}`} class="hover:text-coral-dark">
                    {partner.email}
                  </a>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- EU disclaimer strip -->
    <div class="mt-12 flex flex-col gap-6 border-t border-slate-200 pt-8 sm:flex-row sm:items-start">
      <EuInterregLogo />
      <div class="max-w-3xl">
        <p class="font-display italic font-semibold text-coral-dark">&ldquo;{t("footer.quote")}&rdquo;</p>
        <p class="mt-2 text-xs italic text-slate-muted">{t("footer.disclaimer")}</p>
        <a href="https://www.hungary-serbia.eu" class="mt-2 inline-block text-xs font-medium text-coral-dark hover:underline">
          www.hungary-serbia.eu
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 flex flex-col items-center justify-between gap-3 border-t border-slate-200 pt-6 text-xs text-slate-muted sm:flex-row">
      <p>&copy; {year} SMARTour. {t("footer.rights")}</p>
      <div class="flex gap-4">
        <a href="/terms-and-conditions" class="hover:text-coral-dark">{t("footer.terms")}</a>
        <a href="/privacy-policy" class="hover:text-coral-dark">{t("footer.privacy")}</a>
      </div>
    </div>
  </div>
</footer>
